{{- define CustomAttribute .TagName}}
/* CustomAttribute- This method is supported only on tags that support custom attributes in HTML5 standart.
Using name, value and boolean is specified how to generate this attribuite into final HTML file. */
func ({{.}} *{{.}}Attributes) CustomAttribute(name, value string, boolean bool) *{{.}} {
    {{.}}.RegisterAttribute(name, value, boolean)
    return {{.}}
}
{{end -}}

