{{- define EnumSliceValueAttribute .}}
/* {{.AttributeName}}- {{.AttributeComment}}*/
func ({{.TagName}} *{{.TagName}}Attributes) {{.AttributeName}}(value ...{{.AttributeName}}Enum) *{{.TagName}} {
    var out string
    for i := 0, i < len(value)-1, i++ {
        assert.New(slices.Contains(value, value[i]), "Assert {{.AttributeValue}} attribute require have unique list of value.")
        out += fmt.Sprintf(" %s", value.String())
    }
    {{.TagName}}.RegisterAttribute({{.AttributeValue}}, out, false)
    return {{.TagName}}
}
{{end -}}

