}
{{end -}}

{{- define AttributeConstructor .}}
/*AttrOf{{capitalizeFirst .TagName}}- Constructor of related attributes to this web tag*/
func AttrOf{{capitalizeFirst .TagNamea}}() *{{.TagName}}Attributes {
	return &{{.TagName}}Attributes{base.NewAttributes()}
}
{{end -}}

{{- define NodeConstructorSelfClosing .}}
/*{{capitalizeFirst .TagName}}- {{.TagComment}}*/
func {{capitalizeFirst .TagName}}(attributes *{{.TagName}}Attributes) base.Content {
    return base.NewSelfClosingNode(
        "{{.TagValue}}",
        model.{{.Namespace}},
        attributes.Attributes,
    )
}
{{end -}}

{{- define NodeContructor .}}
/*{{capitalizeFirst .TagName}}- {{.TagComment}}*/
func {{capitalizeFirst .TagName}}(attributes *{{.TagName}}Attributes, tags ...any) base.Content {
	var (
		supportedNodes = []string{{{.SupportedChildren}}}
		children       []base.Content
	)
	for _, tag := range tags {
		switch t := tag.(type) {
		case string:
			children = append(children, stringValue(t))
		case base.Content:
			assert.New(
				model.{{.Namespace}} == t.GetNamespace() {{- if .svg}}{{template "svg"}}{{end}}{{if .math}}{{template "math"}}{{end}},
				fmt.Sprintf("Assert %s tag isn't suported inside {{.Namespace}}.", t.GetNamespace()),
			)
			assert.New(
			    slices.Contains(supportedNodes, t.GetName()),
				fmt.Sprintf("Assert %s tag isn't suported inside {{.TagName}} tag.", t.GetName()),
			)
			children = append(children, t)
		default:
			panic(fmt.Sprintf("assert \"%s\" type isn't supported.", reflect.TypeOf(t).String()))
		}
	}
	return base.NewFullTagNode(
		"{{.TagValue}}",
		model.{{.Namespace}},
		attributes.Attributes,
		&children,
	)
}
{{end -}}

{{define svg}} || t.GetName() == "svg"{{end}}
{{define math}} || t.GetName() == "math"{{end}}
{{- end -}}
