{{- define "AriaMethod"}}
/*
Aria - {{.AttrComment}}
*/
func ({{.StructVar}} *{{.StructName}}) Aria(name, value string) *{{.StructName}} {
    var ariaName string
	if name == "" {
		ariaName = "aria"
	} else {
		ariaName = fmt.Sprintf("aria-%s", name)
	}
	if slices.Contains(web.GlobAriaName, name) {
        {{.StructVar}}.registerAttribute(ariaName, value)
    } else {
	    //TODO: Specific aria attributes need to be check before adding to the map of attributes
        {{.StructVar}}.registerAttribute(ariaName, value)
    }
    return {{.StructVar}}
}
{{end}}

