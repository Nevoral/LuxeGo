{{- define "AttributeMethod"}}
/*
{{.AttrName}} - {{.AttrComment}}
*/
func ({{.StructVar}} *{{.StructName}}) {{.AttrName}}(value string) *{{.StructName}} {
    if {{.StructVar}}.attributes == nil {
        {{.StructVar}}.attributes = []*Attribute{}
    }
    {{.StructVar}}.registerAttribute("{{.AttrValue}}", value)
    return {{.StructVar}}
}
{{end}}

