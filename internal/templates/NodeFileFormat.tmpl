{{- define "CustomAttribute"}}
/*
CustomAttribute - This is method for adding custom attribute, that are not in HTML5 specification.
*/
func ({{.StructVar}} *{{.StructName}}) CustomAttribute(attributes ...*Attribute) *{{.StructName}} {
    {{.StructVar}}.registerAttributes(attributes...)
    return {{.StructVar}}
}
{{end}}

{{- define "ChildrenMethod"}}
/*
Children - Method for nesting tags into parent tag
*/
func ({{.StructVar}} *{{.StructName}}) Children(tags ...any) *{{.StructName}}{
    return {{.StructVar}}.supportedChildrenCheck(tags)
}
{{end}}

{{- define "SupportedChildrenCheckMethod"}}
func ({{.StructVar}} *{{.StructName}}) supportedChildrenCheck(tags []any) *{{.StructName}} {
    for _, tagObj := range tags {
        switch val := tagObj.(type) {
        case string:
            {{.StructVar}}.registerChildren(TextContentSvg(val).getTag())
        case content:
            {{.StructVar}}.registerChildren(val.getTag())
        case []content:
            for _, child := range val {
                {{.StructVar}}.registerChildren(child.getTag())
            }
        default:
            panic(fmt.Sprintf("Unsupported content type. %v", val))
        }
    }
    return {{.StructVar}}
}
{{end}}

{{- define "ConstructorFunc"}}
func {{.FuncName}}(tags []any) *{{.StructName}} {
    node := &{{.StructName}}{
        tag: &tag{
            name:                "{{.TagValue}}",
            attributes:          nil,
            supportedAttributes: nil,
            tagType:             spec.{{.TagType}},
            namespace:           spec.{{.Namespace}},
            children:            nil,
            textContent:         "",
            parent:              nil,
            nestingLevel:        0,
            renderFormat:        DefaultHtml,
        },
    }
    return node.supportedChildrenCheck(tags)
}
{{end}}

