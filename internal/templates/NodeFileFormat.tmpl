    {{- range $ind, $val:= .import -}}
        {{"\t"}}{{$val}}
    {{- end -}}
{{else if gt (len .import) 1 -}}
    import (
    {{- range $ind, $val:= .import}}
        {{$val}}
    {{- end}}
)
{{- end}}
{{end}}


